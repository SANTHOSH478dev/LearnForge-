# LearnForge AI Environment Configuration

# Backend
SECRET_KEY=learnforge-ai-super-secret-production-grade-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (defaults to SQLite, or provide PostgreSQL connection string)
DATABASE_URL=sqlite:///./learnforge.db
# DATABASE_URL=postgresql://user:password@localhost:5432/learnforge_db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=35

# AI Engine (Optional - will use high-fidelity Smart Grounded Engine if not provided)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
USE_MOCK_AI=false
